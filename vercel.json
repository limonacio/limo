{
  "buildCommand": "node node_modules/vite/bin/vite.js build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/limodoro/(.*)", "destination": "/limodoro/$1" },
    { "source": "/downloads/(.*)", "destination": "/downloads/$1" },
    { "source": "/((?!limodoro|downloads).*)", "destination": "/index.html" }
  ]
}
